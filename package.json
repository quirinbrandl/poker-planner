{
  "name": "poker-planner",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run",
    "test:mobile": "jest --runInBand",
    "test": "npm run test:integration && npm run test:mobile",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "expo": "~55.0.0",
    "expo-crypto": "~55.0.0",
    "expo-sqlite": "~55.0.0",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "@types/react": "~19.2.0",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.0",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.11"
  }
}
